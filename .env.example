PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret
# Set this to use MongoDB (via mongoose). Leave it empty to use the
# built-in JSON-file storage (users.json / books.json / requests.json).
MONGODB_URI=
# Email of the admin user (used by GET /api/admin/users). Leave empty to
# disable the admin endpoints.
ADMIN_EMAIL=
